{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "draw_graph",
  "version": "0.1.0",
  "identifier": "com.raveensrk.draw-graph",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "draw_graph", "width": 1400, "height": 900, "minWidth": 700, "minHeight": 450, "theme": "Dark" }
    ],
    "security": { "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
